# Salin ke .env.podman lalu sesuaikan:  cp .env.podman.example .env.podman
# File ini dipakai oleh compose.yaml (env_file) untuk service app dan db.

APP_NAME=SemprongsShop
APP_ENV=production
APP_DEBUG=false
# Generate: podman compose run --rm --no-deps app php artisan key:generate --show
APP_KEY=
APP_URL=http://localhost:8090

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_DATABASE=semprongsshop
DB_USERNAME=semprong
DB_PASSWORD=secret

# Variabel untuk image MariaDB (samakan dengan DB_* di atas)
MARIADB_DATABASE=semprongsshop
MARIADB_USER=semprong
MARIADB_PASSWORD=secret
MARIADB_ROOT_PASSWORD=rootsecret

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# Jalankan migrasi otomatis saat container start
RUN_MIGRATIONS=true
# Set true sekali saja untuk membuat akun admin (admin@gmail.com / 12345678)
RUN_SEEDERS=false
